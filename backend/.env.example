# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/genealadin

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_V1_STR=/api/v1
PROJECT_NAME=Genealadin
PROJECT_VERSION=0.1.0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Scraping
SCRAPE_TIMEOUT=30
SCRAPE_MAX_DEPTH=5
SCRAPE_CONCURRENT_REQUESTS=5

# Logging
LOG_LEVEL=INFO

# Sentry (optional)
SENTRY_DSN=
